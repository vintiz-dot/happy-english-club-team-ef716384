{
  "name": "hec-docs-printer",
  "private": true,
  "version": "1.0.0",
  "description": "HEC Docs printer: a Cloudflare Worker that turns a signed-in user's rendered document HTML into a PDF/PNG with Cloudflare Browser Rendering.",
  "type": "module",
  "scripts": {
    "deploy": "node node_modules/wrangler/bin/wrangler.js deploy",
    "dev": "node node_modules/wrangler/bin/wrangler.js dev",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "wrangler": "4.156.2"
  }
}
