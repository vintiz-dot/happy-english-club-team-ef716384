{# icon: bolt | star | flame. Drawn inline, decorative (aria-hidden), no text. #}
{% macro stat_tile(value, label, icon="star") %}
<div class="stat-tile">
  <span class="stat-tile__icon" aria-hidden="true">
  {% if icon == "bolt" %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
  {% elif icon == "flame" %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M12 22c4 0 7-2.8 7-7 0-3-1.6-5-3.2-6.8-.6 1.3-1.3 2-2.3 2.3C14 7 12.8 4 10 2 10 6 5 8.4 5 15c0 4.2 3 7 7 7z"/></svg>
  {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>
  {% endif %}
  </span>
  <span class="stat-tile__value">{{ value }}</span>
  <span class="stat-tile__label">{{ label }}</span>
</div>
{% endmacro %}
