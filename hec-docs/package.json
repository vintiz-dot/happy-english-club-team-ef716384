{
  "name": "hec-docs",
  "version": "1.0.0",
  "private": true,
  "description": "HEC Docs: template-driven PDF rendering for Happy English Club",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "hec-docs": "./bin/hec-docs.mjs"
  },
  "scripts": {
    "setup": "npm ci && npm run fonts",
    "fonts": "node scripts/vendor-fonts.ts",
    "tokens": "node src/tokens/build.ts",
    "build": "npm run tokens && npm run typecheck",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
    "render": "node src/cli.ts render",
    "serve": "node src/server.ts",
    "qa": "node scripts/qa.ts",
    "baseline:update": "node scripts/qa.ts --update-baselines",
    "contact-sheet": "node scripts/contact-sheet.ts",
    "test:snapshot": "node --test \"test/snapshot/*.test.ts\""
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "nunjucks": "3.2.4",
    "pdf-lib": "1.17.1",
    "playwright": "1.58.2",
    "qrcode": "1.5.4",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@fontsource/be-vietnam-pro": "5.1.1",
    "@fontsource/cormorant-garamond": "5.1.1",
    "@fontsource/noto-emoji": "5.1.1",
    "@fontsource/noto-sans-math": "5.1.1",
    "@fontsource/noto-sans-symbols-2": "5.1.1",
    "@types/node": "24.0.10",
    "@types/nunjucks": "3.2.6",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.5",
    "eslint": "9.32.0",
    "pdfjs-dist": "4.10.38",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "@types/sanitize-html": "2.16.0"
  }
}
