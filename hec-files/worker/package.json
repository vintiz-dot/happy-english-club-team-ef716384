{
  "name": "hec-files",
  "private": true,
  "version": "1.0.0",
  "description": "HEC Files: the school app's files in Cloudflare R2, with access decided by the school database as the signed-in person.",
  "type": "module",
  "scripts": {
    "deploy": "node node_modules/wrangler/bin/wrangler.js deploy",
    "dev": "node node_modules/wrangler/bin/wrangler.js dev",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "wrangler": "4.156.2"
  }
}
